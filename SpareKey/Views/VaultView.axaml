<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="using:SpareKey.Core"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="SpareKey.Views.VaultView">

    <!-- Layout only. Events are connected in VaultView.axaml.cs -->

    <!-- DockPanel: Top and Bottom parts first, the last child fills the rest -->
    <DockPanel Margin="16">

        <!-- Top bar: search + Add + Lock -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     PlaceholderText="Search title, username or website"/>
            <Button x:Name="AddButton" Grid.Column="1" Content="+ Add"
                    Classes="accent" Margin="8,0,0,0"/>
            <Button x:Name="LockButton" Grid.Column="2" Content="Lock"
                    Margin="8,0,0,0"/>
        </Grid>

        <!-- Bottom: buttons for the selected entry + a status line -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CopyUsernameButton" Content="Copy username"/>
                <Button x:Name="CopyPasswordButton" Content="Copy password"/>
                <Button x:Name="EditButton" Content="Edit"/>
                <Button x:Name="DeleteButton" Content="Delete"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Opacity="0.7"/>
        </StackPanel>

        <!-- The list fills the space that is left -->
        <ListBox x:Name="EntryList">
            <ListBox.ItemTemplate>
                <!-- How ONE entry looks in the list.
                     x:DataType tells Avalonia what each item is (needed for {Binding}) -->
                <DataTemplate x:DataType="core:VaultEntry">
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Username}" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
