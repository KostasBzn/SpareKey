<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="SpareKey.Views.RecoveryView">

    <!-- Layout only. Events are connected in RecoveryView.axaml.cs -->

    <ScrollViewer>
        <StackPanel Width="420" Spacing="14" Margin="0,24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Forgot your password?" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Use your 24 recovery words to set a new one." Opacity="0.7"
                       HorizontalAlignment="Center" Margin="0,-10,0,10"/>

            <StackPanel Spacing="4">
                <TextBlock Text="Vault file"/>
                <TextBox x:Name="VaultPathBox"/>
            </StackPanel>

            <!-- AcceptsReturn: words can be typed on several lines -->
            <StackPanel Spacing="4">
                <TextBlock Text="Recovery words"/>
                <TextBox x:Name="WordsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="100"
                         PlaceholderText="Type the 24 words in order, separated by spaces"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="New master password"/>
                <TextBox x:Name="NewPasswordBox" PasswordChar="•"
                         Classes="revealPasswordButton"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Repeat the new password"/>
                <TextBox x:Name="ConfirmPasswordBox" PasswordChar="•"
                         Classes="revealPasswordButton"/>
            </StackPanel>

            <Button x:Name="RecoverButton" Content="Recover vault" Classes="accent"
                    IsDefault="True"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,8"/>

            <TextBlock x:Name="MessageText" Foreground="#D13438"
                       TextWrapping="Wrap" TextAlignment="Center" IsVisible="False"/>

            <HyperlinkButton x:Name="BackButton" Content="Back to unlock"
                             HorizontalAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
