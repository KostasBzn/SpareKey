<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400"
        x:Class="SpareKey.Dialogs.ChangePasswordDialog"
        Title="Change password"
        Icon="/Assets/sparekey.ico"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <!-- Layout only. Events are connected in ChangePasswordDialog.axaml.cs -->

    <StackPanel Margin="20" Spacing="10">

        <StackPanel Spacing="4">
            <TextBlock Text="Current password"/>
            <TextBox x:Name="CurrentPasswordBox" PasswordChar="•"
                     Classes="revealPasswordButton"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="New password"/>
            <TextBox x:Name="NewPasswordBox" PasswordChar="•"
                     Classes="revealPasswordButton"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Repeat the new password"/>
            <TextBox x:Name="ConfirmPasswordBox" PasswordChar="•"
                     Classes="revealPasswordButton"/>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="Your 24 recovery words stay the same. Old backups still open with the old password."/>

        <TextBlock x:Name="MessageText" Foreground="#D13438"
                   TextWrapping="Wrap" IsVisible="False"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,6,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"/>
            <Button x:Name="ChangeButton" Content="Change password" Classes="accent" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
