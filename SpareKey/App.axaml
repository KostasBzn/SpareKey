<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SpareKey.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Corner roundness for the whole app. Default is 4, higher = rounder. -->
    <Application.Resources>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </Application.Resources>

    <Application.Styles>
        <!-- accent colour+ for light and dark mode. -->
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2563EB"/>
                <ColorPaletteResources x:Key="Dark" Accent="#3B82F6"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- room inside buttons and text boxes -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10,7"/>
        </Style>
    </Application.Styles>
</Application>